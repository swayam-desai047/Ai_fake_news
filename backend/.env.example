# ── Supabase (backend only — never put the service-role key in the frontend) ──
SUPABASE_URL=https://your-project-ref.supabase.co
# Service-role / secret key: needed to insert and update articles (bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── API ──
# Comma-separated browser origins allowed by CORS (your deployed frontend URL in production).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Requests per minute per client IP for /analyze and /report (0 disables the limit).
RATE_LIMIT_PER_MINUTE=30
# Optional: enables POST /api/ingest when set; send it in the X-Ingest-Token header.
INGEST_TOKEN=

# ── Scheduler ──
ENABLE_SCHEDULER=1
INGEST_INTERVAL_MINUTES=30
# 1 = run one ingestion right after the API starts.
INGEST_ON_STARTUP=0

# ── Models ──
ENABLE_MODELS=1
FAKE_NEWS_MODEL=mrm8488/bert-tiny-finetuned-fake-news-detection
SENTIMENT_MODEL=distilbert-base-uncased-finetuned-sst-2-english
# The fake-news model's config has no id2label; LABEL_1 = fake is the documented assumption.
FAKE_NEWS_FAKE_LABEL=LABEL_1
FAKE_NEWS_REAL_LABEL=LABEL_0
